# Copy to `.env` on the server.
#
# This is not the app's .env. Docker Compose reads this file from the checkout to fill in
# ${DUCKDNS_DOMAIN} and friends; the app's own DATABASE_URL is set in docker-compose.yml and
# points into the mounted volume. Nothing here ever enters the image.

# Your free subdomain from https://www.duckdns.org, pointed at this VM's reserved public IP.
DUCKDNS_DOMAIN=your-league.duckdns.org

# Let's Encrypt uses this only to warn you before a certificate expires.
ACME_EMAIL=you@example.com

# So dates rendered on the server match what your league sees in the browser.
TZ=Europe/Madrid
