# Local SQLite database. Change the path to move the league data elsewhere.
DATABASE_URL="file:./dev.db"

# In a container the database lives on a mounted volume, so the path is absolute:
# DATABASE_URL="file:/data/league.db"

# Where the event deck (data/events.json) is read from at request time. Defaults to
# `<cwd>/data`, which is right for dev, `next start` and the container alike.
# PKF_DATA_DIR="/app/data"

# Session cookies are marked `secure` in production, so logins fail over plain HTTP.
# Set this only on a LAN box with no TLS in front — never on a public deployment.
# ALLOW_INSECURE_COOKIE=1
