{
  "name": "pk-fantasy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run clean && next dev",
    "build": "npm run clean && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "roster:build": "tsx scripts/build-roster.ts",
    "tiers:fetch": "tsx scripts/fetch-tiers.ts",
    "tiers:doc": "tsx scripts/tiers-doc.ts",
    "guide:doc": "tsx scripts/draft-guide.ts",
    "guide:report": "tsx scripts/draft-report.ts",
    "market:update": "npm run tiers:fetch && npm run roster:build && npm run db:seed && npm run tiers:doc && npm run guide:doc",
    "db:push": "prisma db push",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "prisma studio",
    "clean": "node -e \"require('node:fs').rmSync('.next',{recursive:true,force:true})\"",
    "setup": "prisma db push --skip-generate && prisma generate && tsx scripts/seed.ts",
    "db:demo": "tsx scripts/demo.ts",
    "db:reset": "tsx scripts/demo.ts --reset"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^6.1.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "prisma": "^6.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
